NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Server-only credentials for a dedicated Supabase demo account with appropriately scoped RLS access.
SUPABASE_DEMO_EMAIL=<demo-account-email>
SUPABASE_DEMO_PASSWORD=<demo-account-password>

# Server-only. Required only when running `npm run db:seed`.
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>
